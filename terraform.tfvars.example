# AWS Academy Learner Lab: use us-east-1. Conta própria pode usar sa-east-1.
aws_region   = "us-east-1"
project_name = "tech-challenge"
environment  = "homolog"

db_name     = "techbase"
db_username = "techdev"
# Nunca committe a senha real — use este arquivo local ou TF_VAR_db_password no CI
db_password = "CHANGE-ME-strong-password"

db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20
# Console: "18.6-R1" → API: "18.6". Sem pin o default da conta pode ser outro minor (ex.: 18.3).
db_engine_version = "18.6"
db_multi_az          = false
db_publicly_accessible = false

# allowed_cidr_blocks = ["X.X.X.X/32"]  # opcional: seu IP para debug via bastion/VPN
